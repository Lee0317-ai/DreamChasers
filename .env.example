# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
AUTH_SECRET=replace-with-a-long-random-secret

# Email login. In local development, missing SMTP values make Auth.js print the login link to the server terminal.
AUTH_EMAIL_SERVER=smtp://localhost:1025
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="DreamChasers <no-reply@example.com>"

# Database and cache are configured in later tasks.
DATABASE_URL=postgresql://postgres:change-me@db.tgrxbwyfwtlrmrjmvihf.supabase.co:5432/postgres?sslmode=require
DIRECT_DATABASE_URL=postgresql://postgres:change-me@db.tgrxbwyfwtlrmrjmvihf.supabase.co:5432/postgres?sslmode=require
REDIS_URL=redis://localhost:6379

# AI image provider. Keep real API keys in local or deployment environment variables.
# Switch providers by changing only AI_IMAGE_ACTIVE_PROVIDER.
AI_IMAGE_ACTIVE_PROVIDER=pptoken

AI_IMAGE_PROVIDER_PPTOKEN_BASE_URL=https://api.pptoken.cc/v1
AI_IMAGE_PROVIDER_PPTOKEN_API_KEY=replace-me
AI_IMAGE_PROVIDER_PPTOKEN_MODEL=gpt-image-2
AI_IMAGE_PROVIDER_PPTOKEN_PROTOCOL=openai-compatible

AI_IMAGE_PROVIDER_RIGHT_CODE_BASE_URL=https://www.right.codes/draw
AI_IMAGE_PROVIDER_RIGHT_CODE_API_KEY=replace-me
AI_IMAGE_PROVIDER_RIGHT_CODE_MODEL=gpt-image-2
AI_IMAGE_PROVIDER_RIGHT_CODE_PROTOCOL=right-code-draw

# Supabase public API values for client-side reads if needed later.
NEXT_PUBLIC_SUPABASE_URL=https://tgrxbwyfwtlrmrjmvihf.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-me
